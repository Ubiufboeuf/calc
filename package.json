{
  "name": "@mangufaf/zalk",
  "version": "1.3.3",
  "description": "A lightweight, zero-dependency mathematical expression engine written in TypeScript.",
  "keywords": [
    "math",
    "expression",
    "parser",
    "calculator",
    "ast",
    "evaluator",
    "typescript",
    "zero-dependency",
    "zalk"
  ],
  "homepage": "https://github.com/Ubiufboeuf/calc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ubiufboeuf/calc.git"
  },
  "bugs": {
    "url": "https://github.com/Ubiufboeuf/calc/issues"
  },
  "license": "MIT",
  "author": "mAngo",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun --watch index.ts",
    "build": "bun build.ts && dts-bundle-generator --no-check -o dist/index.d.ts src/index.ts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "dts-bundle-generator": "9.5.1",
    "typescript": "5"
  }
}
